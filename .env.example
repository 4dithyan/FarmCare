# FarmCare Environment Variables
# Copy this file to .env and fill in your details

# Django Secret Key (Generate a random one for production)
DJANGO_SECRET_KEY=django-insecure-farmcare-cardamom-secret-key-2024-change-in-production

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Debug Mode (True for development, False for production)
DEBUG=True
